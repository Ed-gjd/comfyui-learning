{
  "unet": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "ltx-2-3-22b-dev_transformer_only_fp8_input_scaled.safetensors",
      "weight_dtype": "fp8_e4m3fn_fast"
    }
  },
  "lora": {
    "class_type": "LoraLoaderModelOnly",
    "inputs": {
      "model": ["unet", 0],
      "lora_name": "ltx-2.3-22b-distilled-lora-dynamic_fro09_avg_rank_105_bf16.safetensors",
      "strength_model": 0.5
    }
  },
  "clip_loader": {
    "class_type": "LTXAVTextEncoderLoader",
    "inputs": {
      "text_encoder": "gemma_3_12B_it_fp4_mixed.safetensors",
      "ckpt_name": "ltx-2.3_text_projection_bf16.safetensors",
      "device": "default"
    }
  },
  "vae_loader": {
    "class_type": "VAELoader",
    "inputs": {"vae_name": "LTX23_video_vae_bf16.safetensors"}
  },
  "pos": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "一位古装女子在雪中庭院缓缓转身回眸，红色汉服衣袂轻扬，雪花缓缓飘落，唇角浅笑，电影质感，特写镜头",
      "clip": ["clip_loader", 0]
    }
  },
  "neg": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "pc game, console game, video game, cartoon, childish, ugly",
      "clip": ["clip_loader", 0]
    }
  },
  "ltx_cond": {
    "class_type": "LTXVConditioning",
    "inputs": {
      "positive": ["pos", 0],
      "negative": ["neg", 0],
      "frame_rate": 24.0
    }
  },
  "load_img": {
    "class_type": "LoadImage",
    "inputs": {"image": "char_snow.png"}
  },
  "preproc": {
    "class_type": "LTXVPreprocess",
    "inputs": {
      "image": ["load_img", 0],
      "img_compression": 18
    }
  },
  "latent": {
    "class_type": "EmptyLTXVLatentVideo",
    "inputs": {
      "width": 832,
      "height": 1216,
      "length": 97,
      "batch_size": 1
    }
  },
  "img2video": {
    "class_type": "LTXVImgToVideoInplace",
    "inputs": {
      "vae": ["vae_loader", 0],
      "image": ["preproc", 0],
      "latent": ["latent", 0],
      "strength": 1.0,
      "bypass": false
    }
  },
  "noise": {
    "class_type": "RandomNoise",
    "inputs": {"noise_seed": 20260808}
  },
  "sampler_sel": {
    "class_type": "KSamplerSelect",
    "inputs": {"sampler_name": "euler"}
  },
  "sigmas": {
    "class_type": "ManualSigmas",
    "inputs": {"sigmas": "1.0, 0.99375, 0.9875, 0.98125, 0.975, 0.909375, 0.725, 0.421875, 0.0"}
  },
  "guider": {
    "class_type": "CFGGuider",
    "inputs": {
      "model": ["lora", 0],
      "positive": ["ltx_cond", 0],
      "negative": ["ltx_cond", 1],
      "cfg": 1.0
    }
  },
  "sampler": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": ["noise", 0],
      "guider": ["guider", 0],
      "sampler": ["sampler_sel", 0],
      "sigmas": ["sigmas", 0],
      "latent_image": ["img2video", 0]
    }
  },
  "vae_decode": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["sampler", 0],
      "vae": ["vae_loader", 0]
    }
  },
  "create_video": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": ["vae_decode", 0],
      "fps": 24.0
    }
  },
  "save": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["create_video", 0],
      "filename_prefix": "s05_ltx23",
      "format": "mp4",
      "codec": "h264"
    }
  }
}
